# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/fifa2026
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fifa2026?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Auth0 Configuration
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://your-api-audience

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
# For production:
# CORS_ORIGIN=https://your-github-pages-url.github.io

# API Football Configuration (Optional)
API_FOOTBALL_KEY=your-api-football-key
API_FOOTBALL_URL=https://v3.football.api-sports.io

# TheSportsDB Configuration (Optional - Backup)
THESPORTSDB_URL=https://www.thesportsdb.com/api/v1/json/3

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Tournament Configuration
TOURNAMENT_START_DATE=2026-06-11T00:00:00Z
PREDICTIONS_LOCK_DATE=2026-06-10T23:59:59Z

# Logging
LOG_LEVEL=info
# Options: error, warn, info, http, verbose, debug, silly
# Seed API Protection (for Render free tier without shell access)
SEED_SECRET=your-super-secret-seed-key-change-this-in-production